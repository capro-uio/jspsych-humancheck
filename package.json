{
  "name": "jspsych-humancheck-dev",
  "private": true,
  "type": "module",
  "description": "Development workspace for @jspsych-contrib/extension-humancheck. Not published.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "test:coverage": "npm run test --workspaces -- --coverage",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps",
    "serve": "http-server packages/extension-humancheck -p 4173 -s",
    "sync:contrib": "node scripts/sync-contrib.mjs"
  },
  "devDependencies": {
    "@jspsych/plugin-survey-text": "^2.1.1",
    "@playwright/test": "^1.50.0",
    "http-server": "^14.1.1"
  }
}
